aws_region         = "us-east-1"
project_name       = "salesforce-manager"
environment        = "dev"
availability_zones = ["us-east-1a", "us-east-1b"]

# Use the Salesforce org My Domain configured for the Connected App.
salesforce_login_url = "https://orgfarm-d483781df2-dev-ed.develop.my.salesforce.com"

# Leave these empty to use the secret containers created by this environment.
# Secret values must be populated outside Terraform.
salesforce_client_id_secret_arn     = ""
salesforce_client_secret_arn        = ""

# The first platform apply creates empty containers. Set true only after values exist.
salesforce_secrets_ready = false
